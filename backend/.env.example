# ============================================================
# CallVeroQA - Variables de entorno (copia este archivo a .env)
# ============================================================

# --- Base de datos ---
# En docker-compose usa el host "postgres". En local usa "localhost".
DATABASE_URL=postgresql://callqa:callqa@postgres:5432/callqa
REDIS_URL=redis://redis:6379/0

# --- Almacenamiento de audios ---
STORAGE_PROVIDER=local            # local | s3
STORAGE_PATH=/data/audios         # ruta usada si STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Transcripción ---
WHISPER_PROVIDER=groq             # groq | local | azure
GROQ_API_KEY=

# --- Análisis con IA ---
# groq = GRATIS (reutiliza la GROQ_API_KEY de arriba). claude/openai/azure = de pago.
AI_PROVIDER=groq                  # groq | claude | openai | azure
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_GROQ=openai/gpt-oss-120b
AI_MODEL_CLAUDE=claude-sonnet-5
AI_MODEL_OPENAI=gpt-4o

# --- Azure (preparado para migración futura a infraestructura Indra) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# --- Aplicación ---
APP_ENV=production
APP_DEFAULT_LANGUAGE=es
APP_MAX_AUDIO_SIZE_MB=100
# true = procesa la llamada inline sin worker Celery (Render free); false = usa Celery (local/Docker).
PROCESS_INLINE=false
CORS_ORIGINS=https://callaibrate.vercel.app,http://localhost:3000
